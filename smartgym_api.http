@host = http://localhost:8080
# JWT (session token de Clerk). Obtenerlo desde el front: await Clerk.session.getToken() (dura ~60 s).
@token = <pega-aqui-el-jwt>
@today = {{$datetime 'yyyy-MM-dd'}}

###
# Usuario actual (rol, perfil, profile_complete). Requiere claims role y email en el token.
GET {{host}}/api/v1/me
Authorization: Bearer {{token}}

###
# Completar perfil de cliente (crea el cliente y vincula el DNI)
POST {{host}}/api/v1/me/onboarding
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Carlos Mendoza",
  "age": 28,
  "dni": "74582136"
}

###
# Crear Customer (solo admin)
POST {{host}}/api/v1/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "alice@example.com",
  "name": "Alice Runner",
  "age": 29,
  "dni": "11223344"
}

###
# Listar Customers (solo admin)
GET {{host}}/api/v1/customers
Authorization: Bearer {{token}}
Accept: application/json

###
# Obtener Customer por email (admin, el propio cliente o su entrenador)
GET {{host}}/api/v1/customers/alice@example.com
Authorization: Bearer {{token}}
Accept: application/json

###
# Crear Trainer (solo admin). dni es opcional (8 dígitos). Invita al correo en Clerk con el rol "entrenador"
# si el backend tiene CLERK_SECRET_KEY; la respuesta trae invitation.status (INVITED, ROLE_UPDATED, SKIPPED, FAILED).
POST {{host}}/api/v1/trainers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "coach.bob@example.com",
  "name": "Bob Coach",
  "age": 40,
  "specialty": "strength",
  "dni": "22334455"
}

###
# Reintentar la invitación de Clerk de un entrenador existente (solo admin)
POST {{host}}/api/v1/trainers/coach.bob@example.com/invite
Authorization: Bearer {{token}}

###
# Listar Trainers (cualquier usuario autenticado)
GET {{host}}/api/v1/trainers
Authorization: Bearer {{token}}
Accept: application/json

###
# Obtener Trainer por email
GET {{host}}/api/v1/trainers/coach.bob@example.com
Authorization: Bearer {{token}}
Accept: application/json

###
# Linkear DNI a Customer (solo admin)
POST {{host}}/api/v1/identity/customer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "12345678",
  "email": "alice@example.com"
}

###
# Linkear DNI a Trainer (solo admin)
POST {{host}}/api/v1/identity/trainer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "87654321",
  "email": "coach.bob@example.com"
}

###
# Resolver identidad por DNI (admin o el dueño del DNI)
GET {{host}}/api/v1/identity/12345678
Authorization: Bearer {{token}}
Accept: application/json

###
# Crear Booking (fecha fijada por el servidor = hoy). Cliente: solo a su nombre; admin: cualquiera; entrenador: 403
# Ajusta la hora si ya existe una reserva para ese trainer
POST {{host}}/api/v1/bookings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerEmail": "alice@example.com",
  "trainerEmail": "coach.bob@example.com",
  "time": "10:30",
  "note": "Primera sesión"
}

###
# Listar Bookings (admin: todas; entrenador y cliente: solo las suyas)
GET {{host}}/api/v1/bookings
Authorization: Bearer {{token}}
Accept: application/json

###
# Listar Bookings de un Trainer por fecha
GET {{host}}/api/v1/trainers/coach.bob@example.com/bookings?date={{today}}
Authorization: Bearer {{token}}
Accept: application/json

###
# Listar todas las Bookings de un Trainer (admin o el propio entrenador)
GET {{host}}/api/v1/trainers/coach.bob@example.com/bookings
Authorization: Bearer {{token}}
Accept: application/json

###
# Listar Bookings de un Trainer en un rango (from/to inclusivos y opcionales)
GET {{host}}/api/v1/trainers/coach.bob@example.com/bookings?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{token}}
Accept: application/json

###
# Disponibilidad de un Trainer (horas ocupadas; cualquier usuario autenticado; date opcional, por defecto hoy)
GET {{host}}/api/v1/trainers/coach.bob@example.com/availability?date={{today}}
Authorization: Bearer {{token}}
Accept: application/json

###
# Clientes de un Trainer (admin o el propio entrenador)
GET {{host}}/api/v1/trainers/coach.bob@example.com/customers
Authorization: Bearer {{token}}
Accept: application/json

###
# Registrar acceso por DNI (Customer)
POST {{host}}/api/v1/access
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "12345678"
}

###
# Listar asistencia por DNI (Customer)
GET {{host}}/api/v1/attendance/12345678
Authorization: Bearer {{token}}
Accept: application/json

###
# Agregar progreso (peso, % grasa, % músculo) para Customer por DNI
POST {{host}}/api/v1/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "12345678",
  "weightKg": 70.4,
  "bodyFatPct": 18.2,
  "musclePct": 42.0
}

###
# Listar progreso por DNI
GET {{host}}/api/v1/progress/12345678
Authorization: Bearer {{token}}
Accept: application/json

###
# Asignar rutina semanal aleatoria al Customer por DNI (admin: cualquiera; entrenador: solo sus clientes)
POST {{host}}/api/v1/routines/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "12345678"
}

###
# Historial de rutinas por DNI (dueño, su entrenador o admin)
GET {{host}}/api/v1/routines/history/12345678
Authorization: Bearer {{token}}
Accept: application/json

###
# Rutina activa para un día específico (ejemplo: monday)
GET {{host}}/api/v1/routines/active/12345678?day=monday
Authorization: Bearer {{token}}
Accept: application/json

###
# El domingo no tiene bloque: 200 con {"day":"sunday","block":null} (descanso)
GET {{host}}/api/v1/routines/active/12345678?day=sunday
Authorization: Bearer {{token}}
Accept: application/json

###
# Asignar rutina semanal por correo del cliente (se envía dni O customer_email, nunca ambos)
POST {{host}}/api/v1/routines/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "customer_email": "alice@example.com" }

###
# Historial de rutinas por correo (dueño, su entrenador o admin)
GET {{host}}/api/v1/routines/by-email/alice@example.com/history
Authorization: Bearer {{token}}

###
# Rutina activa por correo para un día
GET {{host}}/api/v1/routines/by-email/alice@example.com/active?day=monday
Authorization: Bearer {{token}}

###
# Progreso por correo (dueño, su entrenador o admin)
GET {{host}}/api/v1/progress/by-email/alice@example.com
Authorization: Bearer {{token}}

###
# Caso negativo: Booking duplicada (mismo trainer/hoy/time) => 409 esperado
POST {{host}}/api/v1/bookings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerEmail": "alice@example.com",
  "trainerEmail": "coach.bob@example.com",
  "time": "10:30",
  "note": "Conflicto"
}

###
# Caso negativo: DNI no linkeado en asistencia => 404/422 según validación
GET {{host}}/api/v1/attendance/00000000
Authorization: Bearer {{token}}
Accept: application/json

###
# Caso negativo: Progreso con valores fuera de rango => 422
POST {{host}}/api/v1/progress
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "dni": "12345678",
  "weightKg": 0.0,
  "bodyFatPct": -1,
  "musclePct": 200
}
